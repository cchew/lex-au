                <subsection eId="schedule-1__amdact-1__item-13__qstr-1__subsec-1">
                  <num>1</num>
                  <content>
                    <p><role refersTo="#minister">The Minister</role> must cause an independent review of the assistance scheme provided for by this Act to be conducted in accordance with subsections (1A) and (1B).</p>
                  </content>
                </subsection>
