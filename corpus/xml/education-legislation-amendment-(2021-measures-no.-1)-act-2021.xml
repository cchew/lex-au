          <hcontainer name="amendedAct" eId="schedule-1__amdact-1">
            <heading>Australian Research Council Act 2001</heading>
            <hcontainer name="item" eId="schedule-1__amdact-1__item-1">
              <num>1</num>
              <heading>At the end of subsection 48(2)</heading>
              <content>
                <p>Add:</p>
              </content>
              <quotedStructure eId="schedule-1__amdact-1__item-1__qstr-1" startQuote="“" endQuote="”" from="#" to="#">
                <content>
                  <p>; (t)	the financial year starting on <date date="2023-07-01">1 July 2023</date>.</p>
                </content>
              </quotedStructure>
            </hcontainer>
            <hcontainer name="item" eId="schedule-1__amdact-1__item-2">
              <num>2</num>
              <heading>Paragraph 49(u)</heading>
              <content>
                <p>Omit “$786,212,000”, substitute “$803,409,000”.</p>
              </content>
            </hcontainer>
            <hcontainer name="item" eId="schedule-1__amdact-1__item-3">
              <num>3</num>
              <heading>Paragraph 49(v)</heading>
