            <hcontainer name="item" eId="schedule-1__amdact-1__item-16">
              <num>16</num>
              <heading>Subsection 138(4)</heading>
              <content>
                <p>Repeal the subsection, substitute:</p>
              </content>
              <quotedStructure eId="schedule-1__amdact-1__item-16__qstr-1" startQuote="“" endQuote="”" from="#" to="#">
                <subsection eId="schedule-1__amdact-1__item-16__qstr-1__subsec-3">
                  <num>3</num>
                  <content>
                    <p>A person may only be appointed as a Commissioner if <role refersTo="#minister">the Minister</role> is satisfied that the person has appropriate qualifications, knowledge or experience.</p>
                  </content>
                  <authorialNote placement="end" eId="note-2" marker="2">
