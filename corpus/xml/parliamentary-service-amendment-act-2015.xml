    <preface>
      <p>Parliamentary Service Amendment Act 2015</p>
      <p>No. 26, 2015</p>
      <p>An Act to amend the <i>Parliamentary Service Act 1999</i>, and for related purposes</p>
      <p>Contents</p>
      <p>1	Short title	1</p>
