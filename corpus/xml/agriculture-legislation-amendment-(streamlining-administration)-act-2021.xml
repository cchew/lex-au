                <p>Add:</p>
              </content>
              <quotedStructure eId="schedule-1__amdact-2__item-5__qstr-1" startQuote="“" endQuote="”" from="#" to="#">
                <subsection eId="schedule-1__amdact-2__item-5__qstr-1__subsec-2">
                  <num>2</num>
                  <content>
                    <p><role refersTo="#secretary">The Secretary</role> may delegate <role refersTo="#secretary">the Secretary</role>’s powers and functions under <ref href="#sec-20A">section 20A</ref> only to an SES employee, or an acting SES employee, in the Department.</p>
