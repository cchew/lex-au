            <hcontainer name="clause" eId="schedule-1__part-2__clause-7">
              <num>7</num>
              <heading>Application of amendments in items 1 to 4</heading>
              <content>
                <p>The amendments made by items 1 to 4 of this Schedule apply in relation to:</p>
              </content>
              <paragraph eId="schedule-1__part-2__clause-7__para-a">
                <num>a</num>
                <content>
                  <p>offences committed; or</p>
                </content>
              </paragraph>
              <paragraph eId="schedule-1__part-2__clause-7__para-b">
                <num>b</num>
                <content>
                  <p>contraventions, or acts or omissions, that occurred;</p>
                </content>
              </paragraph>
              <content>
                <p>on or after the commencement of this Schedule.</p>
              </content>
