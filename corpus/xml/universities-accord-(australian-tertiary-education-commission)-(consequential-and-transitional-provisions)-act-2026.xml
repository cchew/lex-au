                  <subsection eId="schedule-1__amdact-2__item-9__qstr-1__sec-58B__subsec-1">
                    <num>1</num>
                    <content>
                      <p>The ATEC must review the standards that make up the Higher Education Standards Framework at least once every 5 years.</p>
                    </content>
                  </subsection>
                  <subsection eId="schedule-1__amdact-2__item-9__qstr-1__sec-58B__subsec-2">
                    <num>2</num>
