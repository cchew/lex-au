                <quotedStructure eId="schedule-1__part-1__amdact-1__item-7__qstr-1" startQuote="“" endQuote="”" from="#" to="#">
                  <paragraph eId="schedule-1__part-1__amdact-1__item-7__qstr-1__para-i">
                    <num>i</num>
                    <content>
