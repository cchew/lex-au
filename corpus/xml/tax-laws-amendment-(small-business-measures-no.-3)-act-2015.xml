                <heading>Section 13-1 (after table item headed “sickness benefits”)</heading>
                <content>
                  <p>Insert:</p>
                </content>
                <quotedStructure eId="schedule-1__part-2__amdact-2__item-1__qstr-1" startQuote="“" endQuote="”" from="#" to="#">
                  <table>
                    <tr>
                      <td>small business</td>
                      <td></td>
                    </tr>
                    <tr>
                      <td>small business income</td>
                      <td>Subdivision 328-F</td>
