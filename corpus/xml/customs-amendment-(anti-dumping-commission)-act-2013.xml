    <body>
      <section eId="sec-1">
        <num>1</num>
        <heading>Short title</heading>
        <content>
          <p>		This Act may be cited as the <i>Customs Amendment (Anti</i><i>-</i><i>Dumping Commission) Act 2013</i>.</p>
        </content>
      </section>
      <section eId="sec-2">
        <num>2</num>
        <heading>Commencement</heading>
        <content>
          <p>This Act commences on <date date="2013-07-01">1 July 2013</date>.</p>
        </content>
      </section>
      <section eId="sec-3">
        <num>3</num>
        <heading>Schedule(s)</heading>
        <content>
          <p>Each Act that is specified in a Schedule to this Act is amended or repealed as set out in the applicable items in the Schedule concerned, and any other item in a Schedule to this Act has effect according to its terms.</p>
        </content>
      </section>
    </body>
