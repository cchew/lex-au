              <hcontainer name="item" eId="schedule-1__part-2__amdact-4__item-2">
                <num>8</num>
                <heading>Section 17</heading>
                <content>
                  <p>Repeal the section, substitute:</p>
                </content>
                <quotedStructure eId="schedule-1__part-2__amdact-4__item-2__qstr-1" startQuote="“" endQuote="”" from="#" to="#">
                  <section eId="schedule-1__part-2__amdact-4__item-2__qstr-1__sec-17">
                    <num>17</num>
                    <heading>Relationship with other laws</heading>
                    <content>
                      <p>This Part does not, by implication, limit the Commonwealth’s power to make, vary or administer an arrangement or grant under another law of the Commonwealth including:</p>
                    </content>
                    <paragraph eId="schedule-1__part-2__amdact-4__item-2__qstr-1__sec-17__para-a">
                      <num>a</num>
                      <content>
                        <p>	(a)	subsection 32B(1) of the <i>Financial Framework (Supplementary Powers) Act 1997</i>; and</p>
                      </content>
                    </paragraph>
                    <paragraph eId="schedule-1__part-2__amdact-4__item-2__qstr-1__sec-17__para-b">
                      <num>b</num>
                      <content>
                        <p>	(b)	Chapter 2D of the <i>Social Security Act 1991</i> (about arrangements and grants relating to assisting persons to obtain and maintain paid work).</p>
                      </content>
                    </paragraph>
                  </section>
                </quotedStructure>
