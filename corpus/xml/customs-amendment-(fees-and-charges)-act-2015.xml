                <p>Add:</p>
              </content>
              <quotedStructure eId="schedule-1__amdact-1__item-10__qstr-1" startQuote="“" endQuote="”" from="#" to="#">
                <content>
                  <p>; and (g)	be accompanied by the warehouse licence application charge.</p>
                </content>
              </quotedStructure>
            </hcontainer>
            <hcontainer name="item" eId="schedule-1__amdact-1__item-11">
              <num>11</num>
