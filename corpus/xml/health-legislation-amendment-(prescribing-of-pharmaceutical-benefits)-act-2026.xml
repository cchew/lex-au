              <quotedStructure eId="schedule-1__amdact-2__item-16__qstr-1" startQuote="“" endQuote="”" from="#" to="#">
                <paragraph eId="schedule-1__amdact-2__item-16__qstr-1__para-ac">
                  <num>ac</num>
                  <content>
                    <p>a letter from an authorised nurse prescriber signed on or after <date date="2026-07-01">1 July 2026</date> to that effect; or</p>
                  </content>
                </paragraph>
              </quotedStructure>
            </hcontainer>
            <hcontainer name="item" eId="schedule-1__amdact-2__item-17">
              <num>23</num>
              <heading>Subparagraph 99ZJ(4)(b)(ii)</heading>
