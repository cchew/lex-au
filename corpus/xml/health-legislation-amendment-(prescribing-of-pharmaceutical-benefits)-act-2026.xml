              </content>
            </hcontainer>
            <hcontainer name="item" eId="schedule-1__amdact-2__item-18">
              <num>24</num>
              <heading>At the end of subsection 99ZJ(4A)</heading>
              <content>
                <p>Add:</p>
              </content>
              <quotedStructure eId="schedule-1__amdact-2__item-18__qstr-1" startQuote="“" endQuote="”" from="#" to="#">
                <content>
                  <p>; or (c)	for substances prescribed by an authorised nurse prescriber—on or after <date date="2026-07-01">1 July 2026</date>.</p>
                </content>
              </quotedStructure>
            </hcontainer>
            <hcontainer name="item" eId="schedule-1__amdact-2__item-19">
              <num>25</num>
              <heading>After subparagraph 99ZK(3)(c)(iiia)</heading>
              <content>
                <p>Insert:</p>
              </content>
              <quotedStructure eId="schedule-1__amdact-2__item-19__qstr-1" startQuote="“" endQuote="”" from="#" to="#">
                <paragraph eId="schedule-1__amdact-2__item-19__qstr-1__para-iiib">
                  <num>iiib</num>
