              <quotedStructure eId="schedule-1__amdact-1__item-10__qstr-1" startQuote="“" endQuote="”" from="#" to="#">
                <subsection eId="schedule-1__amdact-1__item-10__qstr-1__subsec-6A">
                  <num>6A</num>
                  <content>
                    <p>	(6A)	The rate of tax payable by a trustee under paragraph 276-105(2)(a) of the <i>Income Tax Assessment Act 1997</i> is as set out in Schedule 10A.</p>
