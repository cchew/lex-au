                <content>
                  <p>Repeal the paragraph, substitute:</p>
                </content>
                <quotedStructure eId="schedule-1__part-1__amdact-1__item-32__qstr-1" startQuote="“" endQuote="”" from="#" to="#">
                  <paragraph eId="schedule-1__part-1__amdact-1__item-32__qstr-1__para-a">
