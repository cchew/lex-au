      <section eId="sec-1">
        <num>1</num>
        <heading>Short title</heading>
        <content>
          <p>		This Act may be cited as the <i>Higher Education Support Amendment (2009 Budget Measures)</i><i> </i><i>Act 2009</i>.</p>
        </content>
      </section>
