              </content>
              <quotedStructure eId="schedule-1__amdact-1__item-2__qstr-1" startQuote="“" endQuote="”" from="#" to="#">
                <subsection eId="schedule-1__amdact-1__item-2__qstr-1__subsec-1">
                  <num>1</num>
                  <content>
                    <p>If:</p>
                  </content>
                  <paragraph eId="schedule-1__amdact-1__item-2__qstr-1__subsec-1__para-a">
                    <num>a</num>
                    <content>
                      <p>a safety case is in force in relation to a facility at any time during a year; and</p>
                    </content>
                  </paragraph>
                  <paragraph eId="schedule-1__amdact-1__item-2__qstr-1__subsec-1__para-b">
                    <num>b</num>
                    <content>
                      <p>the facility is located, or proposed to be located, in Commonwealth waters;</p>
                    </content>
                    <content>
                      <p>levy is imposed on the safety case in respect of that year.</p>
                    </content>
                  </paragraph>
                </subsection>
              </quotedStructure>
