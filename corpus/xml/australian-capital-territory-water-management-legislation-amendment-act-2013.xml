            <quotedStructure eId="schedule-1__item-6__qstr-1" startQuote="“" endQuote="”" from="#" to="#">
              <content>
                <p>; and (c)	has responsibility for:</p>
              </content>
              <paragraph eId="schedule-1__item-6__qstr-1__para-i">
                <num>i</num>
                <content>
                  <p>the management of the taking of water on National Land; and</p>
                </content>
              </paragraph>
              <paragraph eId="schedule-1__item-6__qstr-1__para-ii">
                <num>ii</num>
                <content>
                  <p>the regulation of the taking of water on National Land.</p>
                </content>
              </paragraph>
            </quotedStructure>
          </hcontainer>
          <hcontainer name="item" eId="schedule-1__item-7">
            <num>7</num>
            <heading>Section 30 (heading)</heading>
            <content>
              <p>Repeal the heading, substitute:</p>
            </content>
            <quotedStructure eId="schedule-1__item-7__qstr-1" startQuote="“" endQuote="”" from="#" to="#">
              <section eId="schedule-1__item-7__qstr-1__sec-30">
                <num>30</num>
