              </section>
            </quotedStructure>
          </hcontainer>
          <hcontainer name="item" eId="schedule-1__item-8">
            <num>8</num>
            <heading>Paragraph 30(2)(a)</heading>
            <content>
              <p>Repeal the paragraph, substitute:</p>
            </content>
            <quotedStructure eId="schedule-1__item-8__qstr-1" startQuote="“" endQuote="”" from="#" to="#">
              <paragraph eId="schedule-1__item-8__qstr-1__para-a">
                <num>a</num>
                <content>
