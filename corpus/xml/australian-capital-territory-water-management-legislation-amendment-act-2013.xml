                </content>
              </paragraph>
              <paragraph eId="schedule-1__item-8__qstr-1__para-iii">
                <num>iii</num>
                <content>
                  <p>the regulation of the taking of water on National Land; and</p>
                </content>
              </paragraph>
            </quotedStructure>
