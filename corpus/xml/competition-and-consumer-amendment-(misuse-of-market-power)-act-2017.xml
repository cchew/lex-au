    <body>
      <section eId="sec-1">
        <num>1</num>
        <heading>Short title</heading>
        <content>
          <p>		This Act is the <i>Competition and Consumer </i><i>Amendment </i><i>(Misuse of Market Power)</i><i> Act 201</i><i>7</i>.</p>
        </content>
      </section>
      <section eId="sec-2">
