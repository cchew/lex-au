            <hcontainer name="item" eId="schedule-2__amdact-1__item-2">
              <num>2</num>
              <heading>Subsections 151AJ(4) and (5)</heading>
              <content>
                <p>Omit “45B, 46,”.</p>
              </content>
            </hcontainer>
