            <hcontainer name="item" eId="schedule-1__amdact-1__item-1">
              <num>1</num>
              <heading>At the end of subsection 48(2)</heading>
              <content>
                <p>Add:</p>
              </content>
              <quotedStructure eId="schedule-1__amdact-1__item-1__qstr-1" startQuote="“" endQuote="”" from="#" to="#">
                <content>
                  <p>; (q)	the financial year starting on <date date="2020-07-01">1 July 2020</date>;</p>
                </content>
                <paragraph eId="schedule-1__amdact-1__item-1__qstr-1__para-r">
                  <num>r</num>
                  <content>
                    <p>the financial year starting on <date date="2021-07-01">1 July 2021</date>.</p>
                  </content>
                </paragraph>
              </quotedStructure>
            </hcontainer>
            <hcontainer name="item" eId="schedule-1__amdact-1__item-2">
              <num>2</num>
              <heading>Paragraphs 49(r), (s) and (t)</heading>
              <content>
                <p>Repeal the paragraphs, substitute:</p>
              </content>
              <quotedStructure eId="schedule-1__amdact-1__item-2__qstr-1" startQuote="“" endQuote="”" from="#" to="#">
                <paragraph eId="schedule-1__amdact-1__item-2__qstr-1__para-r">
                  <num>r</num>
                  <content>
                    <p>for the financial year starting on <date date="2017-07-01">1 July 2017</date>—$758,055,000; and</p>
                  </content>
                </paragraph>
                <paragraph eId="schedule-1__amdact-1__item-2__qstr-1__para-s">
                  <num>s</num>
                  <content>
                    <p>for the financial year starting on <date date="2018-07-01">1 July 2018</date>—$759,925,000; and</p>
                  </content>
                </paragraph>
                <paragraph eId="schedule-1__amdact-1__item-2__qstr-1__para-t">
                  <num>t</num>
                  <content>
                    <p>for the financial year starting on <date date="2019-07-01">1 July 2019</date>—$771,932,000; and</p>
                  </content>
                </paragraph>
                <paragraph eId="schedule-1__amdact-1__item-2__qstr-1__para-u">
                  <num>u</num>
                  <content>
                    <p>for the financial year starting on <date date="2020-07-01">1 July 2020</date>—$771,932,000; and</p>
                  </content>
                </paragraph>
                <paragraph eId="schedule-1__amdact-1__item-2__qstr-1__para-v">
                  <num>v</num>
                  <content>
                    <p>for the financial year starting on <date date="2021-07-01">1 July 2021</date>—$771,932,000.</p>
                  </content>
