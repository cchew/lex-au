                  <num>125A</num>
                  <heading>GST-inclusive payments</heading>
                  <subsection eId="schedule-1__amdact-1__item-38__qstr-1__sec-125A__subsec-1">
                    <num>1</num>
                    <content>
                      <p>If:</p>
                    </content>
