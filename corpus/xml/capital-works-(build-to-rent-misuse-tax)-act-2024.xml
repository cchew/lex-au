    <preface>
      <p>Capital Works (Build to Rent Misuse Tax) Act 2024</p>
      <p>No. 112, 2024</p>
      <p>An Act to impose tax on certain build to rent developments, and for related purposes</p>
      <p>Contents</p>
      <p>1	Short title	1</p>
