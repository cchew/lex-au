            <hcontainer name="item" eId="schedule-1__amdact-5__item-4">
              <num>10</num>
              <heading>Section 4 (definition of the Vice-Chairman)</heading>
              <content>
                <p>Repeal the definition.</p>
              </content>
            </hcontainer>
            <hcontainer name="item" eId="schedule-1__amdact-5__item-5">
              <num>11</num>
              <heading>Section 4 (note)</heading>
              <content>
                <p>Repeal the note.</p>
