                <paragraph eId="schedule-1__amdact-5__item-7__qstr-1__para-iiic">
                  <num>iiic</num>
                  <content>
                    <p>a compulsory TSL repayment amount, worked out by reference to the person’s taxable income of the year of income, payable by the person immediately before the post-notice crediting;</p>
                  </content>
                </paragraph>
              </quotedStructure>
