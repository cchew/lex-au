              <quotedStructure eId="schedule-1__amdact-5__item-9__qstr-1" startQuote="“" endQuote="”" from="#" to="#">
                <subsection eId="schedule-1__amdact-5__item-9__qstr-1__subsec-1A">
                  <num>1A</num>
                  <content>
                    <p>For the purposes of subparagraph (1)(a)(iv), the following are listed:</p>
                  </content>
                  <paragraph eId="schedule-1__amdact-5__item-9__qstr-1__subsec-1A__para-a">
                    <num>a</num>
                    <content>
                      <p>income tax;</p>
