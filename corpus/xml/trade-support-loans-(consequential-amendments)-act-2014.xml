                    </content>
                  </paragraph>
                  <paragraph eId="schedule-1__amdact-5__item-9__qstr-1__subsec-1A__para-c">
                    <num>c</num>
                    <content>
                      <p>compulsory TSL repayment amount;</p>
                    </content>
                  </paragraph>
                  <paragraph eId="schedule-1__amdact-5__item-9__qstr-1__subsec-1A__para-d">
                    <num>d</num>
                    <content>
                      <p>FS assessment debt;</p>
                    </content>
                  </paragraph>
                  <paragraph eId="schedule-1__amdact-5__item-9__qstr-1__subsec-1A__para-e">
                    <num>e</num>
                    <content>
