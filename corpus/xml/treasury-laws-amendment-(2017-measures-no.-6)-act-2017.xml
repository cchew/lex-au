                    <p>a payment of *digital currency;</p>
                  </content>
                </paragraph>
                <paragraph eId="schedule-1__amdact-1__item-14__qstr-1__para-iii">
                  <num>iii</num>
                  <content>
                    <p>a supply; and</p>
                  </content>
                </paragraph>
              </quotedStructure>
            </hcontainer>
            <hcontainer name="item" eId="schedule-1__amdact-1__item-15">
              <num>15</num>
              <heading>Paragraph 79-90(2)(b)</heading>
