              <quotedStructure eId="schedule-1__amdact-1__item-5__qstr-1" startQuote="“" endQuote="”" from="#" to="#">
                <section eId="schedule-1__amdact-1__item-5__qstr-1__sec-6">
                  <num>6</num>
                  <heading>Meanings of specified 10 year period and meets the 4 years or less requirement</heading>
                </section>
