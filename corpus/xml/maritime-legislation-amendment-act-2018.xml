              <quotedStructure eId="schedule-1__amdact-1__item-4__qstr-1" startQuote="“" endQuote="”" from="#" to="#">
                <subsection eId="schedule-1__amdact-1__item-4__qstr-1__subsec-7">
                  <num>7</num>
                  <content>
                    <p>A reference to this Law in subsection (3) does not include a reference to regulations or any other legislative instrument made under this Law.</p>
                  </content>
                </subsection>
