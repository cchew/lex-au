                  <num>4</num>
                  <content>
                    <p>Subsection (3) does not apply to the term “regulations”.</p>
                  </content>
                </subsection>
              </quotedStructure>
            </hcontainer>
            <hcontainer name="item" eId="schedule-1__amdact-1__item-2">
              <num>2</num>
