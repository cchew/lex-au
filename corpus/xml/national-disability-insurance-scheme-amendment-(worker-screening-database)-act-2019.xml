    <body>
      <section eId="sec-1">
        <num>1</num>
        <heading>Short title</heading>
        <content>
          <p>		This Act is the <i>National Disability Insurance Scheme Amendment (Worker Screening Database) Act 2019.</i></p>
        </content>
      </section>
